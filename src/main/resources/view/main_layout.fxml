<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="900.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gletchick.db.controller.MainController">

    <left>
        <VBox prefWidth="200.0" spacing="15.0" style="-fx-background-color: #2c3e50;">
            <children>
                <Label text="ТЕАТР " textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showPoster"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;" text="Афиша" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showMyTickets"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;" text="Мои билеты" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showAdminPanel"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;" text="Админ-панель" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showProfile"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;" text="Профиль" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #ecf0f1;">
            <children>
                <Label text="Добро пожаловать в кассу театра!" textFill="#7f8c8d">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
            </children>
        </StackPane>
    </center>
</BorderPane>