<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.gletchick.db.controller.BookingController">
    <children>
        <Label fx:id="headerLabel" text="Бронирование: Название спектакля" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <VBox spacing="5.0">
            <Label text="Выберите сеанс:" textFill="#7f8c8d" />
            <ComboBox fx:id="sessionComboBox" maxWidth="300.0" onAction="#handleSessionSelected" promptText="Доступные даты и время" />
        </VBox>

        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <Label text="Выберите место:" textFill="#7f8c8d" />
            <FlowPane fx:id="seatsPane" hgap="10.0" vgap="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;" />
        </VBox>

        <HBox spacing="10.0">
            <Button maxWidth="1.7976931348623157E308" onAction="#handleBuyTicket" styleClass="admin-action-button" text="Купить" HBox.hgrow="ALWAYS" />
            <Button maxWidth="1.7976931348623157E308" onAction="#handleBookTicket" styleClass="admin-action-button" text="Забронировать" HBox.hgrow="ALWAYS" />
        </HBox>
    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>