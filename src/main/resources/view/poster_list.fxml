<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: #ecf0f1;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.gletchick.db.controller.PosterController">
    <children>
        <Label text="Текущая афиша" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <VBox spacing="10.0">
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <TextField fx:id="titleFilter" promptText="Название спектакля..." prefWidth="220.0" HBox.hgrow="ALWAYS" />
                <TextField fx:id="directorFilter" promptText="Режиссер..." prefWidth="220.0" HBox.hgrow="ALWAYS" />
                <Button fx:id="resetButton" text="Сбросить" onAction="#handleResetFilters"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" />
            </HBox>

            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <ComboBox fx:id="genreFilter" prefWidth="150.0" promptText="Жанр" />
                <ComboBox fx:id="ageFilter" prefWidth="200.0" promptText="Возраст" />
                <ComboBox fx:id="languageFilter" prefWidth="150.0" promptText="Язык" />

                 </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #ecf0f1;">
            <content>
                <FlowPane fx:id="posterFlowPane" hgap="20.0" vgap="20.0">
                    <padding>
                        <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>