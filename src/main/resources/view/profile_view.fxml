<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.gletchick.db.controller.ProfileController">

    <VBox fx:id="authContainer" alignment="TOP_CENTER" spacing="20.0">
        <padding><Insets bottom="40" left="40" right="40" top="40" /></padding>
        <Label fx:id="headerLabel" text="Вход в систему">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>
        <VBox alignment="CENTER" maxWidth="400.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                </columnConstraints>
                <children>
                    <Label text="Логин:" GridPane.rowIndex="0" />
                    <TextField fx:id="loginField" promptText="Введите логин" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Label text="Пароль:" GridPane.rowIndex="1" />
                    <PasswordField fx:id="passwordField" promptText="Введите пароль" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label fx:id="lblFirstName" managed="false" text="Имя:" visible="false" GridPane.rowIndex="2" />
                    <TextField fx:id="firstNameField" managed="false" promptText="Имя" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label fx:id="lblSurname" managed="false" text="Фамилия:" visible="false" GridPane.rowIndex="3" />
                    <TextField fx:id="surnameField" managed="false" promptText="Фамилия" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label fx:id="lblPatronymic" managed="false" text="Отчество:" visible="false" GridPane.rowIndex="4" />
                    <TextField fx:id="patronymicField" managed="false" promptText="Отчество" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label fx:id="lblPhone" managed="false" text="Телефон:" visible="false" GridPane.rowIndex="5" />
                    <TextField fx:id="phoneField" managed="false" promptText="+375..." visible="false" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                </children>
            </GridPane>
            <Separator />
            <VBox spacing="10.0">
                <Button fx:id="mainActionButton" maxWidth="1.7976931348623157E308" onAction="#handlePrimaryAction" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" text="Войти" />
                <Button fx:id="secondaryModeButton" maxWidth="1.7976931348623157E308" onAction="#switchMode" style="-fx-background-color: transparent; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 8;" text="Создать аккаунт" />
            </VBox>
        </VBox>
        <Label fx:id="statusLabel" textAlignment="CENTER" wrapText="true" />
    </VBox>

    <VBox fx:id="profileContainer" alignment="TOP_CENTER" spacing="20.0" visible="false" managed="false">
        <padding><Insets bottom="40" left="40" right="40" top="40" /></padding>

        <HBox spacing="30.0" alignment="CENTER" maxWidth="800.0">
            <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10;" HBox.hgrow="SOMETIMES">
                <Label text="Ваши данные" style="-fx-font-weight: bold; -fx-font-size: 16;" />
                <Label fx:id="userFullInfoLabel" text="Загрузка..." wrapText="true" />
                <Button onAction="#handleLogout" text="Выйти из аккаунта" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
            </VBox>

            <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                <Label text="История посещений" style="-fx-font-weight: bold; -fx-font-size: 16;" />
                <ListView fx:id="historyListView" prefHeight="200.0" />
            </VBox>
        </HBox>
    </VBox>
</StackPane>