<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.gletchick.lab2.controller.MainController" prefWidth="500.0">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Оформление билета" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <GridPane hgap="10.0" vgap="15.0">
        <columnConstraints>
            <ColumnConstraints minWidth="120" />
            <ColumnConstraints hgrow="ALWAYS" />
            <ColumnConstraints minWidth="40" />
        </columnConstraints>

        <Label text="Клиент:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="clientComboBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Button fx:id="openEditorButton" text="+" GridPane.columnIndex="2" GridPane.rowIndex="0" />

        <Label text="Сеанс:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="sessionComboBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2" />

        <Label text="Место:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="seatComboBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="2" promptText="Сначала выберите сеанс" />

        <Label text="Статус билета:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <ComboBox fx:id="statusComboBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="2" />

        <Label text="Цена:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="priceField" GridPane.columnIndex="1" GridPane.rowIndex="4" GridPane.columnSpan="2" />
    </GridPane>

    <Separator />

    <HBox spacing="10.0" alignment="CENTER">
        <Button fx:id="buyTicketButton" text="Оформить продажу" maxWidth="Infinity"
                HBox.hgrow="ALWAYS" style="-fx-base: #2ecc71; -fx-text-fill: white;" />

        <Button text="Просмотр билетов" onAction="#handleShowAllTickets"
                prefWidth="150.0" style="-fx-base: #9b59b6; -fx-text-fill: white;" />
    </HBox>
</VBox>