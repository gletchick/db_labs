<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" prefWidth="500.0" prefHeight="500.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.gletchick.lab2.controller.Lab8ClientController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <Label text="Справочник клиентов" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>

    <TitledPane animated="false" text="Новый клиент">
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </padding>

            <Label text="Фамилия:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="txtSurname" GridPane.rowIndex="0" GridPane.columnIndex="1" HBox.hgrow="ALWAYS" />

            <Label text="Имя:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <TextField fx:id="txtName" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Телефон:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextField fx:id="txtPhone" GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <Button text="Добавить в базу" onAction="#addNewClient"
                    style="-fx-background-color: #e1f5fe; -fx-border-color: #b3e5fc;"
                    GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.halignment="RIGHT" />
        </GridPane>
    </TitledPane>

    <TableView fx:id="clientTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colSurname" text="Фамилия" prefWidth="120" />
            <TableColumn fx:id="colName" text="Имя" prefWidth="120" />
            <TableColumn fx:id="colPhone" text="Телефон" prefWidth="150" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Separator />

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Label text="Завершить редактирование и обновить список в билете?" wrapText="true" maxWidth="250" />
        <Button text="ДА" onAction="#handleBtnYes" prefWidth="80"
                style="-fx-background-color: #d4edda; -fx-border-color: #c3e6cb; -fx-font-weight: bold;" />
        <Button text="НЕТ" onAction="#handleBtnNo" prefWidth="80"
                style="-fx-background-color: #f8d7da; -fx-border-color: #f5c6cb;" />
    </HBox>
</VBox>