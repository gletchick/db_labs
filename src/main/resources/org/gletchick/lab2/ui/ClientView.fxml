<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.gletchick.lab2.controller.ClientController">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Реестр клиентов" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <TableView fx:id="clientTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
            <TableColumn fx:id="surnameCol" text="Фамилия" prefWidth="120"/>
            <TableColumn fx:id="nameCol" text="Имя" prefWidth="100"/>
            <TableColumn fx:id="patronymicCol" text="Отчество" prefWidth="120"/>
            <TableColumn fx:id="phoneCol" text="Телефон" prefWidth="130"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>